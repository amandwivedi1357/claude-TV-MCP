# BitGet API credentials
# Get these from: BitGet account → API Management
# Withdrawals: OFF. IP whitelist: ON.
BITGET_API_KEY=your_api_key_here
BITGET_SECRET_KEY=your_secret_key_here
BITGET_PASSPHRASE=your_passphrase_here
ALLOWED_IP_ADDRESSES=203.0.113.5,198.51.100.20
SECRET_ROTATION_ALERT_DAYS=30
SECRET_ROTATION_CRITICAL_DAYS=60
BITGET_BASE_URL=https://api.bitget.com

# Trading mode: "spot" or "futures"
TRADE_MODE=spot

# Portfolio value — used to calculate position size
PORTFOLIO_VALUE_USD=1000

# Trade limits — these are your guardrails
MAX_TRADE_SIZE_USD=100        # No single trade can exceed this value
MAX_TRADES_PER_DAY=3          # Bot stops executing after this many trades in a calendar day
MAX_SLIPPAGE_PERCENT=2        # Reject trades if market price moves more than this
SLIPPAGE_WARNING_PERCENT=1    # Warn if slippage is elevated but still tradable
MAX_EXECUTION_TIME_MS=5000    # Reject trades if signal-to-order time exceeds this
MAX_API_RETRIES=3             # Retry 429 rate limits up to this many times
MIN_REQUEST_SPACING_MS=500    # Minimum spacing between exchange API requests
RATE_LIMIT_BACKOFF_BASE=1000  # Base backoff in ms before retry with jitter
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=10000
HEALTH_CHECK_MAX_RETRIES=3
HEALTH_REQUIRED_COMPONENTS=exchange
SLACK_WEBHOOK_URL=
ENABLE_AUTO_RECOVERY=true
TRADINGVIEW_HEALTH_CHECK_COMMAND=
MCP_HEALTHCHECK_URL=
CLAUDE_HEALTHCHECK_URL=
TRADINGVIEW_RECOVERY_COMMAND=
MCP_RECOVERY_COMMAND=
CLAUDE_RECOVERY_COMMAND=
ORDER_CONFIRMATION_TIMEOUT_MS=10000
ORDER_POLL_INTERVAL_MS=500
RECONCILE_ON_STARTUP=true
OPEN_ORDERS_CACHE_DURATION_MS=5000
STALE_ORDER_TIMEOUT_MS=1800000
PREVENT_DUPLICATE_ENTRIES=true
DUPLICATE_PREVENTION_LOOKBACK_MINUTES=5
NTP_SERVERS=pool.ntp.org,time.nist.gov
MAX_ALLOWED_CLOCK_SKEW_MS=5000
CLOCK_CHECK_INTERVAL_HOURS=1
PAUSE_TRADING_IF_SKEW=true

# Symbol and timeframe
SYMBOL=BTCUSDT
TIMEFRAME=4H

# Set to "true" to run in paper trading mode (logs decisions but never places real orders)
PAPER_TRADING=true
